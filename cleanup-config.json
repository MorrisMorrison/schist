{
  "default_profile": "safe",
  "profiles": {
    "full": {
      "data_directories": [
        "data",
        "test-data", 
        "e2e-data",
        "tmp/schist-*",
        "backend/cmd/schist/test-data-*"
      ],
      "test_directories": [
        "frontend/coverage",
        "backend/coverage", 
        "backend/test-results"
      ],
      "e2e_results": [],
      "log_files": [
        "*.log",
        "logs/**",
        "backend/*.log",
        "frontend/*.log"
      ],
      "temp_files": [
        "*.tmp",
        "*.temp",
        ".tmp/**",
        "tmp/**",
        "/tmp/schist-*",
        "/var/tmp/schist-*",
        "e2e/playwright/.auth/user.json"
      ],
      "search_patterns": [
        "**/node_modules/.cache/**",
        "**/.svelte-kit/output/**",
        "**/dist/**",
        "**/build/**"
      ],
      "system_cleanup": true
    },
    "safe": {
      "data_directories": [
        "data",
        "test-data",
        "e2e-data", 
        "backend/cmd/schist/test-data-*"
      ],
      "test_directories": [
        "frontend/coverage",
        "backend/coverage"
      ],
      "e2e_results": [],
      "log_files": [
        "*.log",
        "logs/**"
      ],
      "temp_files": [
        "*.tmp",
        "*.temp",
        "e2e/playwright/.auth/user.json"
      ],
      "search_patterns": [],
      "system_cleanup": false
    },
    "e2e-only": {
      "data_directories": [
        "backend/cmd/schist/test-data-auth-disabled",
        "backend/cmd/schist/test-data-auth-enabled", 
        "backend/cmd/schist/test-data-worker-1",
        "backend/cmd/schist/test-data-worker-2",
        "backend/cmd/schist/test-data-worker-3",
        "backend/cmd/schist/test-data-worker-4"
      ],
      "test_directories": [],
      "e2e_results": [],
      "log_files": [],
      "temp_files": [
        "e2e/playwright/.auth/user.json"
      ],
      "search_patterns": [],
      "system_cleanup": false
    }
  }
}