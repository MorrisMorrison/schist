{
  "data_directories": [
    "data",
    "test-data", 
    "e2e-data",
    "backend/data",
    "backend/test-data",
    "frontend/test-data",
    "tmp/schist-*"
  ],
  "test_directories": [
    "frontend/test-results",
    "frontend/playwright-report", 
    "frontend/coverage",
    "frontend/e2e-results",
    "backend/coverage",
    "backend/test-results"
  ],
  "e2e_results": [
    "frontend/test-results/**",
    "frontend/playwright-report/**", 
    "frontend/e2e-results/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/.playwright/**"
  ],
  "log_files": [
    "*.log",
    "logs/**",
    "backend/*.log",
    "frontend/*.log", 
    "backend/logs/**",
    "frontend/logs/**",
    "backend/cmd/*/*.log"
  ],
  "temp_files": [
    "*.tmp",
    "*.temp",
    ".tmp/**",
    "tmp/**",
    "/tmp/schist-*",
    "/var/tmp/schist-*",
    "backend/tmp/**",
    "frontend/tmp/**"
  ],
  "search_patterns": [
    "**/node_modules/.cache/**",
    "**/.svelte-kit/output/**",
    "**/dist/tmp/**",
    "**/build/tmp/**",
    "**/.next/**",
    "**/.nuxt/**"
  ]
}