{
	"name": "schist-e2e",
	"private": true,
	"version": "1.0.0",
	"description": "End-to-end tests for Schist application",
	"scripts": {
		"test": "npx playwright test",
		"test:clean": "npx playwright test && npm run cleanup",
		"test:ui": "npx playwright test --ui",
		"test:debug": "npx playwright test --debug",
		"test:headed": "npx playwright test --headed",
		"cleanup": "git -C .. clean -fdx -- e2e/test-results e2e/playwright-report e2e/screenshots e2e/playwright",
		"install-browsers": "npx playwright install --with-deps chromium",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint --fix . && prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.55.0",
		"@types/node": "^25.9.3",
		"eslint": "^9.34.0",
		"eslint-config-prettier": "^10.0.1",
		"globals": "^17.6.0",
		"playwright": "^1.53.0",
		"prettier": "^3.4.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.20.0"
	}
}
