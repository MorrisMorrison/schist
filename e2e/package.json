{
	"name": "schist-e2e",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "End-to-end tests for Schist application",
	"scripts": {
		"test": "npx playwright test && npm run cleanup",
		"test:ui": "npx playwright test --ui",
		"test:debug": "npx playwright test --debug",
		"test:headed": "npx playwright test --headed",
		"cleanup": "cd .. && ./scripts/cleanup.sh --profile=e2e-only",
		"cleanup-test-data": "cd .. && ./scripts/cleanup.sh --profile=e2e-only",
		"install-browsers": "npx playwright install --with-deps chromium"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.1",
		"playwright": "^1.53.0"
	}
}