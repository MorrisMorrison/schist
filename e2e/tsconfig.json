{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"allowJs": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"baseUrl": ".",
		"types": ["node", "@playwright/test"]
	},
	"include": ["./**/*.ts", "./**/*.js"],
	"exclude": ["node_modules", "playwright-report", "test-results"]
}
