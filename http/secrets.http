### Encrypted secret store
### Routes: /api/secrets/*
###
### Personal secrets are encrypted at rest and protected by a passkey. The store
### must be UNLOCKED before list/get/create/update/delete will work — unlock it via
### POST /api/passkeys/unlock (see passkeys.http). While locked, those endpoints
### return 401 "Secret store is locked".

@secretKey = github_token

### Store status — unlocked? has secrets? needs setup?
# @name secretsStatus
GET {{apiUrl}}/secrets/status
# => 200 { "unlocked": ..., "has_secrets": ..., "has_passkeys": ..., "requires_setup": ... }

### List secret keys (requires unlocked store)
GET {{apiUrl}}/secrets
# => 200 { "secrets": ["key1", "key2"] } | 401 if locked

### Create a secret (requires unlocked store)
POST {{apiUrl}}/secrets
Content-Type: application/json

{
  "key": "{{secretKey}}",
  "value": "s3cr3t-value"
}
# => 201 { "message": "Secret created successfully" }

### Get a secret's value by key (requires unlocked store)
GET {{apiUrl}}/secrets/{{secretKey}}
# => 200 { "value": "..." } | 404 if missing

### Update a secret's value (requires unlocked store)
PUT {{apiUrl}}/secrets/{{secretKey}}
Content-Type: application/json

{
  "value": "rotated-value"
}
# => 200 { "message": "Secret updated successfully" }

### Delete a secret (requires unlocked store)
DELETE {{apiUrl}}/secrets/{{secretKey}}
# => 200 { "message": "Secret deleted successfully" }

### Lock the secret store
POST {{apiUrl}}/secrets/lock
# => 200 { "message": "Secret store locked" }

#############################################
### Error cases
#############################################

### Create with a missing required field
POST {{apiUrl}}/secrets
Content-Type: application/json

{
  "key": "{{secretKey}}"
}
