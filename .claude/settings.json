{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit\\|MultiEdit\\|Write",
        "hooks": [{ "type": "command", "command": ".claude/hooks.sh --fast" }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "SessionStart",
        "hooks": [{ "type": "command", "command": "echo 'Please read and follow the instructions in .claude/START_PROMPT.md'" }]
      }
    ],
    "PreCompact": [
      {
        "matcher": "PreCompact",
        "hooks": [{ "type": "command", "command": "echo 'About to compact conversation context'" }]
      }
    ]
  }
}
