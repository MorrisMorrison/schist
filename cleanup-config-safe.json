{
  "data_directories": [
    "data",
    "test-data", 
    "e2e-data",
    "backend/data",
    "backend/test-data",
    "frontend/test-data"
  ],
  "test_directories": [
    "frontend/test-results",
    "frontend/playwright-report", 
    "frontend/coverage",
    "frontend/e2e-results",
    "backend/coverage",
    "backend/test-results"
  ],
  "e2e_results": [
    "frontend/test-results/**",
    "frontend/playwright-report/**", 
    "frontend/e2e-results/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "log_files": [
    "*.log",
    "backend/*.log",
    "frontend/*.log", 
    "backend/cmd/*/*.log",
    "scripts/*.log"
  ],
  "temp_files": [
    "*.tmp",
    "*.temp",
    "backend/tmp/**",
    "frontend/tmp/**"
  ],
  "search_patterns": [
    "frontend/.svelte-kit/output/**",
    "frontend/build/**",
    "backend/cmd/*/cleanup",
    "backend/cmd/cleanup/cleanup"
  ]
}